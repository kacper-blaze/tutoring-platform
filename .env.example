# Skopiuj do .env i dostosuj wartości.

# --- Baza danych -------------------------------------------------------
# Produkcja / docelowo: PostgreSQL (zgodnie ze specyfikacją, sekcja 3.8)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tutoring_platform

# Dev lokalny bez instalowania Postgresa (SQLite) - odkomentuj w razie potrzeby:
# DATABASE_URL=sqlite:///./dev.db

# --- JWT / bezpieczeństwo (RB-B2, RB-B4, sekcja 3.9) --------------------
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# --- Reguły biznesowe (RB-B4: blokada konta) ---------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- Aktywacja konta ----------------------------------------------------
ACTIVATION_TOKEN_EXPIRE_HOURS=24

# --- Środowisko ----------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
